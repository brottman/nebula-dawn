; Engine configuration file.
; Godot 4.7 — Nebula Dawn

config_version=5

[application]

config/name="Nebula Dawn"
config/description="Vertical scrolling space shooter — campaign first, endless later."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoloads/game_state.gd"
AudioBus="*res://scripts/autoloads/audio_bus.gd"
EventBus="*res://scripts/autoloads/event_bus.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

